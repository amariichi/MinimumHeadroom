{
  "hooks": {
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/abs/path/to/scripts/mh-hook.mjs --runtime claude --event permission_required"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/abs/path/to/scripts/mh-hook.mjs --runtime claude --event idle_after_response"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/abs/path/to/scripts/situation-context-hook.sh"
          }
        ]
      }
    ]
  }
}
