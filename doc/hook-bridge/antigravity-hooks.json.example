{
  "minimum-headroom-idle": {
    "Stop": [
      {
        "type": "command",
        "command": "/ABS/PATH/minimum-headroom/scripts/mh-hook.mjs --runtime antigravity --event Stop",
        "timeout": 5
      }
    ]
  },
  "minimum-headroom-approval-attention-optional": {
    "enabled": false,
    "PreToolUse": [
      {
        "matcher": "ask_permission|run_command|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "/ABS/PATH/minimum-headroom/scripts/mh-hook.mjs --runtime antigravity --event permission_required",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "minimum-headroom-input-observer": {
    "PreToolUse": [
      {
        "matcher": "ask_question|ask_permission",
        "hooks": [
          {
            "type": "command",
            "command": "/ABS/PATH/minimum-headroom/scripts/mh-hook.mjs --runtime antigravity --stdout-mode silent --event PreToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "/ABS/PATH/minimum-headroom/scripts/mh-hook.mjs --runtime antigravity --stdout-mode silent --event PostToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "/ABS/PATH/minimum-headroom/scripts/mh-hook.mjs --runtime antigravity --stdout-mode silent --event PreInvocation",
        "timeout": 5
      }
    ]
  }
}
