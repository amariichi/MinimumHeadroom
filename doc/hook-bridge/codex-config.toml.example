# Append these blocks to ~/.codex/config.toml.

# Enable the new Codex hooks system. Required for [[hooks.*]] tables.
# `hooks` is the current key; `codex_hooks` is a deprecated alias still
# accepted in Codex < 0.131 with a warning at startup.
[features]
hooks = true

# Primary path: PermissionRequest fires before approval prompts.
[[hooks.PermissionRequest]]
matcher = ".*"

[[hooks.PermissionRequest.hooks]]
type = "command"
command = "/abs/path/to/scripts/mh-hook.mjs --runtime codex --event PermissionRequest"
timeout = 5

# Primary path: Stop fires when a turn ends.
[[hooks.Stop]]

[[hooks.Stop.hooks]]
type = "command"
command = "/abs/path/to/scripts/mh-hook.mjs --runtime codex --event Stop"
timeout = 5

# Legacy fallback for Codex versions where [features] codex_hooks is unavailable.
# When the new hooks system is active above, this still fires for
# `agent-turn-complete` and is harmless duplication.
# notify = ["/abs/path/to/scripts/mh-hook.mjs", "--runtime", "codex"]

# Observe input waits; these hooks emit no approval decisions. Codex 0.163 baseline.
[[hooks.PreToolUse]]
matcher = "request_user_input"
[[hooks.PreToolUse.hooks]]
type = "command"
command = "/abs/path/to/scripts/mh-hook.mjs --runtime codex --event PreToolUse"
timeout = 5

[[hooks.PostToolUse]]
matcher = ".*"
[[hooks.PostToolUse.hooks]]
type = "command"
command = "/abs/path/to/scripts/mh-hook.mjs --runtime codex --event PostToolUse"
timeout = 5

[[hooks.UserPromptSubmit]]
[[hooks.UserPromptSubmit.hooks]]
type = "command"
command = "/abs/path/to/scripts/mh-hook.mjs --runtime codex --event UserPromptSubmit"
timeout = 5

# Response interruption/session exit is distinct from explicit helper done.
[[hooks.Interrupt]]
[[hooks.Interrupt.hooks]]
type = "command"
command = "/abs/path/to/scripts/mh-hook.mjs --runtime codex --event Interrupt"
timeout = 3

# Response interruption/session exit is distinct from explicit helper done.
[[hooks.SessionEnd]]
[[hooks.SessionEnd.hooks]]
type = "command"
command = "/abs/path/to/scripts/mh-hook.mjs --runtime codex --event SessionEnd"
timeout = 3
