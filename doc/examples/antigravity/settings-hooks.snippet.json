{
  "hooks": {
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "mh-hook-permission",
            "type": "command",
            "command": "/ABS/PATH/minimum-headroom/scripts/mh-hook.mjs --runtime antigravity --stdout-mode silent --event permission_required",
            "timeout": 5000
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "mh-hook-idle",
            "type": "command",
            "command": "/ABS/PATH/minimum-headroom/scripts/mh-hook.mjs --runtime antigravity --stdout-mode silent --event idle_after_response",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
