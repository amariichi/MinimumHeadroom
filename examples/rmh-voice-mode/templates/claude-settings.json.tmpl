{
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__MH_REPO_ROOT__/scripts/mh-hook.mjs --runtime claude --event Notification"
          }
        ],
        "matcher": "idle_prompt|elicitation_dialog|elicitation_url_dialog"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__MH_REPO_ROOT__/scripts/mh-hook.mjs --runtime claude --event Stop"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__MH_REPO_ROOT__/scripts/mh-hook.mjs --runtime claude --event UserPromptSubmit"
          },
          {
            "type": "command",
            "command": "__MH_REPO_ROOT__/scripts/situation-context-hook.sh"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__MH_REPO_ROOT__/scripts/mh-hook.mjs --runtime claude --event PermissionRequest"
          }
        ],
        "matcher": ".*"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__MH_REPO_ROOT__/scripts/mh-hook.mjs --runtime claude --event PreToolUse"
          }
        ],
        "matcher": "AskUserQuestion|ExitPlanMode"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__MH_REPO_ROOT__/scripts/mh-hook.mjs --runtime claude --event PostToolUse"
          }
        ],
        "matcher": ".*"
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__MH_REPO_ROOT__/scripts/mh-hook.mjs --runtime claude --event StopFailure"
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__MH_REPO_ROOT__/scripts/mh-hook.mjs --runtime claude --event PostToolBatch"
          }
        ]
      }
    ]
  }
}
