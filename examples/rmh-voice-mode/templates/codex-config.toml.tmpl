# Reference Codex config for RMH voice mode.
# start-rmh.sh no longer loads this through a temporary CODEX_HOME, because
# CODEX_HOME also contains auth, state DBs, memories, MCP approvals, and hook
# trust. The launcher passes equivalent per-session values with `codex -c`.
# Keep tokens out of this template; run-bound-mcp-server.sh forwards
# MH_FACE_AUTH_TOKEN from the env or from ~/.config/minimum-headroom.env.

model = "__CODEX_MODEL__"

[mcp_servers.minimum_headroom]
command = "__MH_REPO_ROOT__/scripts/run-bound-mcp-server.sh"
args = []
env = { "FACE_WS_URL" = "__FACE_WS_URL__", "VISION_BASE_URL" = "__VISION_BASE_URL__", "MCP_TOOL_NAME_STYLE" = "underscore" }

[features]
hooks = true

[[hooks.PermissionRequest]]
matcher = ".*"

[[hooks.PermissionRequest.hooks]]
type = "command"
command = "__MH_REPO_ROOT__/scripts/mh-hook.mjs --runtime codex --event PermissionRequest"
timeout = 5

[[hooks.UserPromptSubmit]]

[[hooks.UserPromptSubmit.hooks]]
type = "command"
command = "__MH_REPO_ROOT__/scripts/situation-context-hook-codex.mjs"
timeout = 5

[[hooks.Stop]]

[[hooks.Stop.hooks]]
type = "command"
command = "__MH_REPO_ROOT__/scripts/mh-hook.mjs --runtime codex --event Stop"
timeout = 5

# Observe input waits; these hooks emit no approval decisions. Codex 0.163 baseline.
[[hooks.PreToolUse]]
matcher = "request_user_input"
[[hooks.PreToolUse.hooks]]
type = "command"
command = "__MH_REPO_ROOT__/scripts/mh-hook.mjs --runtime codex --event PreToolUse"
timeout = 5

[[hooks.PostToolUse]]
matcher = ".*"
[[hooks.PostToolUse.hooks]]
type = "command"
command = "__MH_REPO_ROOT__/scripts/mh-hook.mjs --runtime codex --event PostToolUse"
timeout = 5

[[hooks.UserPromptSubmit]]
[[hooks.UserPromptSubmit.hooks]]
type = "command"
command = "__MH_REPO_ROOT__/scripts/mh-hook.mjs --runtime codex --event UserPromptSubmit"
timeout = 5

# Response interruption/session exit is distinct from explicit helper done.
[[hooks.Interrupt]]
[[hooks.Interrupt.hooks]]
type = "command"
command = "__MH_REPO_ROOT__/scripts/mh-hook.mjs --runtime codex --event Interrupt"
timeout = 3

# Response interruption/session exit is distinct from explicit helper done.
[[hooks.SessionEnd]]
[[hooks.SessionEnd.hooks]]
type = "command"
command = "__MH_REPO_ROOT__/scripts/mh-hook.mjs --runtime codex --event SessionEnd"
timeout = 3
